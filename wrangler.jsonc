{
  // The MemberCove marketing site: static pages built by Astro into ./dist, served by Workers
  // Static Assets, plus a small Worker for the contact form. See README.md for the first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "membercove-site",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only the API runs the Worker first; every page and file is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    // Where contact form messages go, and who they come from. The sender must be on a domain set up
    // for Cloudflare Email Sending and listed in allowed_sender_addresses below.
    "CONTACT_TO": "hello@membercove.com",
    "CONTACT_FROM": "MemberCove website <no-reply@mail.membercove.com>"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@mail.membercove.com"]
    }
  ],
  // Five messages a minute from one IP address. namespace_id must be unique in the Cloudflare
  // account; the app's limiters use 1001 to 1004.
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }]
  // Custom domain, once membercove.com is a zone in the account (README.md, "Domain"):
  // "routes": [{ "pattern": "membercove.com", "custom_domain": true }, { "pattern": "www.membercove.com", "custom_domain": true }]
}
