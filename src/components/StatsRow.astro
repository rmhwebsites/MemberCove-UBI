---
/** UBI combo-1: a heading on the left; a line of text and three figures with dividers on the right. */
interface Props {
  title: string;
  text: string;
  stats: { value: string; label: string }[];
  class?: string;
}
const { title, text, stats, class: className } = Astro.props;
---

<section class:list={["section", className]} aria-labelledby="stats-title">
  <div class="container-ubi grid grid-cols-[0.9fr_1.1fr] gap-20 lg-down:grid-cols-1 lg-down:gap-10">
    <h2 id="stats-title" class="reveal text-h2">{title}</h2>
    <div class="reveal">
      <p class="text-[26px] leading-[1.35] font-medium sm-down:text-[22px]">{text}</p>
      <ul class="mt-12 grid grid-cols-3 border-t border-ink/15 pt-10 sm-down:grid-cols-1 sm-down:gap-8">
        {
          stats.map((stat, i) => (
            <li class:list={["pr-6", i > 0 && "border-l border-ink/15 pl-8 sm-down:border-l-0 sm-down:pl-0"]}>
              <span class="text-stat block text-gold-ink">{stat.value}</span>
              <span class="mt-3 block text-[18px] leading-[1.4] text-muted-ink">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
