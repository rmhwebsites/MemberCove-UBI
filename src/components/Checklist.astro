---
/** A list with a marigold check before each item (UBI combo-4). */
import Icon from "./Icon.astro";

interface Props {
  items: string[];
  size?: "md" | "sm";
  class?: string;
}
const { items, size = "md", class: className } = Astro.props;
---

<ul class:list={["flex flex-col gap-4", className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-4">
        <span class="check-dot">
          <Icon name="check" size={18} stroke={2.5} />
        </span>
        <span class:list={["pt-[3px] leading-[1.4]", size === "sm" ? "text-[18px]" : "text-[20px]"]}>{item}</span>
      </li>
    ))
  }
</ul>
