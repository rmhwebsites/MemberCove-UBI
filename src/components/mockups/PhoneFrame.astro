---
/** A phone screenshot (390 by 844 at 3x) inside a simple phone body. */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes = "(max-width: 767px) 60vw, 340px", eager = false, class: className } = Astro.props;
---

<figure class:list={["relative rounded-[46px] bg-ink p-[9px] shadow-float", className]}>
  <span class="absolute top-[18px] left-1/2 z-10 h-[22px] w-[30%] -translate-x-1/2 rounded-full bg-ink" aria-hidden="true"></span>
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 720, 1080]}
    sizes={sizes}
    format="webp"
    quality={86}
    loading={eager ? "eager" : "lazy"}
    class="block h-auto w-full rounded-[38px] bg-white"
  />
</figure>
