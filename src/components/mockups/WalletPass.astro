---
/**
 * An Apple Wallet event ticket, drawn in HTML with the same fields and colours MemberCove puts in
 * its passes (src/lib/wallet/apple-pass.ts in the app): date in the header, the event, attendee and
 * ticket, where and the confirmation code, then the QR code. The data is the demo association's.
 */
import QRCode from "qrcode";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const qr = await QRCode.toString("BPMA-GAD7D7", { type: "svg", margin: 0, errorCorrectionLevel: "M", color: { dark: "#12385e", light: "#ffffff" } });
---

<div
  class:list={["wallet-pass w-[300px] rounded-[18px] bg-[#12385e] p-5 text-white shadow-float", className]}
  role="img"
  aria-label="An Apple Wallet ticket for Melissa Carter to the Manager Roundtable on October 14, with a QR code for check-in"
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-8 items-center rounded-md bg-white/15 px-2 text-[12px] font-bold tracking-[0.04em]">BPMA</span>
      <span class="text-[14px] leading-tight font-medium">Bayside PMA</span>
    </div>
    <div class="text-right">
      <p class="label">Date</p>
      <p class="text-[15px] font-medium">Oct 14</p>
    </div>
  </div>

  <div class="mt-5">
    <p class="label">Event</p>
    <p class="mt-1 text-[20px] leading-[1.2] font-medium">Manager Roundtable: 2027 Fee Schedule &amp; Coding Updates</p>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-3">
    <div>
      <p class="label">Attendee</p>
      <p class="text-[15px]">Melissa Carter</p>
    </div>
    <div class="text-right">
      <p class="label">Ticket</p>
      <p class="text-[15px]">Member</p>
    </div>
    <div>
      <p class="label">Where</p>
      <p class="text-[15px]">Online</p>
    </div>
    <div class="text-right">
      <p class="label">Confirmation</p>
      <p class="text-[15px]">BPMA-GAD7D7</p>
    </div>
  </div>

  <div class="mx-auto mt-5 w-[150px] rounded-xl bg-white p-3">
    <div class="qr" set:html={qr} />
  </div>
</div>

<style>
  .label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(199 226 255);
  }
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
