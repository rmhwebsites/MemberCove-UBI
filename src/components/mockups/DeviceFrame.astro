---
/**
 * A desktop screenshot of the app in a dark bezel, like the dashboard mockup in UBI hero-1.
 * Screens are 1440 by 900 captures at 2x from the MemberCove demo association.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes = "(max-width: 991px) 92vw, 1200px", eager = false, class: className } = Astro.props;
---

<figure class:list={["rounded-[22px] bg-ink p-2.5 shadow-float md-down:rounded-2xl md-down:p-1.5", className]}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1920, 2560]}
    sizes={sizes}
    format="webp"
    quality={86}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    class="block h-auto w-full rounded-[14px] bg-stone md-down:rounded-xl"
  />
</figure>
