---
/**
 * UBI contact-3. The form posts to /api/contact (src/worker/contact.ts). With JavaScript it sends
 * in the background and shows the result in place; without it the browser posts the form and the
 * Worker redirects to /contact/thanks/. Turnstile shows only when PUBLIC_TURNSTILE_SITE_KEY is set
 * at build time, and the Worker checks it only when TURNSTILE_SECRET_KEY is set.
 */
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { SITE } from "../../data/site";
import { MEMBER_RANGES } from "../../worker/contact";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const contactItems = [
  { icon: "mail", label: "Email", value: SITE.email, href: `mailto:${SITE.email}` },
  { icon: "layout-grid", label: "See it first", value: "Browse the features", href: "/features/" },
  { icon: "shield-check", label: "Security questions", value: "How we protect your data", href: "/security/" },
];

const inputClass =
  "block h-[52px] w-full rounded-md border border-ink bg-white px-4 text-[18px] text-ink placeholder:text-ink/45 focus:outline-3 focus:outline-offset-2 focus:outline-ink aria-[invalid=true]:border-[#b42318]";
---

<Base title="Contact" description="Book a demo of MemberCove or ask us a question. Tell us about your association and we'll get back to you.">
  <section class="pt-4 pb-[120px] sm-down:pb-[100px]">
    <div class="container-ubi">
      <div class="grid grid-cols-[0.9fr_1.1fr] items-start gap-16 rounded-hero bg-marigold px-20 py-[120px] lg-down:grid-cols-1 lg-down:px-10 lg-down:py-[80px] sm-down:px-4 sm-down:py-12">
        <div class="lg-down:px-0 sm-down:px-2">
          <h1 class="text-display">Let's talk</h1>
          <p class="text-lead mt-6 max-w-[520px] text-ink/80">
            Tell us about your association and what you'd like to see. We'll set up a demo with a sample association's data, or answer your question by email.
          </p>
          <ul class="mt-12 flex flex-col gap-6">
            {
              contactItems.map((item) => (
                <li>
                  <a href={item.href} class="group flex items-center gap-4 text-ink no-underline">
                    <span class="inline-flex size-14 shrink-0 items-center justify-center rounded-full bg-ink text-marigold">
                      <Icon name={item.icon} size={24} />
                    </span>
                    <span>
                      <span class="block text-[16px] tracking-[0.08em] text-ink/70 uppercase">{item.label}</span>
                      <span class="block text-[22px] font-medium group-hover:underline">{item.value}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-card bg-cream px-[60px] py-14 lg-down:px-10 sm-down:px-5 sm-down:py-8" id="form">
          <form action="/api/contact" method="post" data-contact-form>
            <h2 class="text-h3">Send us a message</h2>
            <p class="mt-3 text-[18px] text-muted-ink">Fields marked * are required.</p>

            <div class="mt-8 hidden rounded-panel border border-[#b42318] bg-white p-4 text-[18px] text-[#b42318]" role="alert" data-form-error></div>

            <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-6 sm-down:grid-cols-1">
              <div>
                <label for="name" class="mb-2 block text-[18px] font-medium">Your name *</label>
                <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" class={inputClass} aria-describedby="name-error" />
                <p id="name-error" class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="name"></p>
              </div>
              <div>
                <label for="email" class="mb-2 block text-[18px] font-medium">Work email *</label>
                <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class={inputClass} aria-describedby="email-error" />
                <p id="email-error" class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="email"></p>
              </div>
              <div>
                <label for="association" class="mb-2 block text-[18px] font-medium">Association *</label>
                <input id="association" name="association" type="text" required maxlength="160" autocomplete="organization" class={inputClass} aria-describedby="association-error" />
                <p id="association-error" class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="association"></p>
              </div>
              <div>
                <label for="members" class="mb-2 block text-[18px] font-medium">Number of members</label>
                <div class="relative">
                  <select id="members" name="members" class:list={[inputClass, "appearance-none pr-12"]} aria-describedby="members-error">
                    <option value="">Choose one</option>
                    {MEMBER_RANGES.map((range) => <option value={range}>{range}</option>)}
                  </select>
                  <span class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2"><Icon name="chevron-down" size={20} /></span>
                </div>
                <p id="members-error" class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="members"></p>
              </div>
              <div class="col-span-2 sm-down:col-span-1">
                <label for="message" class="mb-2 block text-[18px] font-medium">What would you like to know?</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  maxlength="5000"
                  class:list={[inputClass, "h-auto py-3 leading-[1.45]"]}
                  aria-describedby="message-error"></textarea>
                <p id="message-error" class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="message"></p>
              </div>
            </div>

            <!-- Left empty by people; bots that fill every field give themselves away. -->
            <div class="honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            {
              turnstileSiteKey && (
                <div class="mt-6">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
                  <p class="mt-2 hidden text-[16px] text-[#b42318]" data-error-for="turnstile" />
                </div>
              )
            }

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              <button type="submit" class="btn btn-dark disabled:cursor-wait disabled:opacity-70" data-submit>
                <span data-submit-label>Send message</span>
                <Icon name="send" size={20} />
              </button>
              <p class="text-[16px] text-muted-ink">We use these details only to reply to you. <a href="/privacy/" class="text-ink">Privacy</a></p>
            </div>
          </form>

          <div class="hidden" role="status" tabindex="-1" data-form-success>
            <span class="inline-flex size-14 items-center justify-center rounded-full bg-marigold text-ink">
              <Icon name="check" size={28} stroke={2.25} />
            </span>
            <h2 class="text-h3 mt-6">Thanks, your message is on its way</h2>
            <p class="mt-4 text-[20px] leading-[1.5] text-muted-ink">
              We'll reply to <strong class="font-medium text-ink" data-success-email></strong>. If anything comes up in the meantime, write to <a href={`mailto:${SITE.email}`} class="text-ink">{SITE.email}</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="../../scripts/contact-form.ts"></script>
</Base>

<style>
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
