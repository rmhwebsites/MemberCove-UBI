---
import Base from "../layouts/Base.astro";
import Checklist from "../components/Checklist.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { PRICING } from "../data/pricing";
import portalHome from "../assets/screens/portal-home.webp";

const faqGroups = [{ id: "pricing", label: "Pricing", items: PRICING.faq }];
---

<Base
  title="Pricing"
  description="One MemberCove plan with every feature, priced by the size of your membership. Tell us about your association and we'll send a quote."
>
  <!-- UBI pricing-2: a marigold band with the ink plan card laid over its lower edge -->
  <section class="pt-4">
    <div class="container-ubi">
      <div class="rounded-hero bg-marigold px-20 pt-[120px] pb-[296px] text-center lg-down:px-10 lg-down:pt-[88px] sm-down:px-5 sm-down:pt-14">
        <p class="mb-5 text-[16px] font-medium tracking-[0.1em] uppercase">Pricing</p>
        <h1 class="text-display mx-auto max-w-[900px]">One plan with everything in it</h1>
        <p class="text-lead mx-auto mt-7 max-w-[760px] text-ink/80">
          The price depends on the size of your membership. Tell us about your association and we'll send you a quote.
        </p>
      </div>

      <div class="on-dark relative mx-auto -mt-[250px] grid max-w-[1160px] grid-cols-2 gap-16 rounded-hero bg-ink p-16 text-white lg-down:mx-4 lg-down:grid-cols-1 lg-down:gap-12 lg-down:p-10 sm-down:mx-0 sm-down:p-6">
        <div>
          <h2 class="text-h2">{PRICING.planName}</h2>
          <p class="mt-6 text-[40px] leading-none font-medium tracking-[-0.02em] sm-down:text-[32px]">{PRICING.price ?? "Quoted for your association"}</p>
          <p class="mt-3 text-[18px] text-white/70">{PRICING.priceNote}</p>
          <a href={PRICING.cta.href} class="btn btn-accent mt-8">{PRICING.cta.label}</a>
          <h3 class="mt-12 font-sans text-[16px] tracking-[0.1em] text-white/60 uppercase">What's included</h3>
          <Checklist items={PRICING.included} size="sm" class="mt-6" />
        </div>
        <div class="border-l border-white/15 pl-16 lg-down:border-t lg-down:border-l-0 lg-down:pt-12 lg-down:pl-0">
          <h2 class="text-h3">How pricing works</h2>
          <ol class="mt-8 flex flex-col gap-8">
            {
              PRICING.steps.map((step, i) => (
                <li class="flex gap-5">
                  <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-marigold text-[20px] font-medium text-ink">{i + 1}</span>
                  <span>
                    <span class="block text-[22px] leading-[1.3] font-medium">{step.title}</span>
                    <span class="mt-2 block text-[18px] leading-[1.45] text-white/70">{step.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="mt-12 rounded-panel bg-white/8 p-6 text-[18px] leading-[1.45] text-white/80">
            Card and ACH payments go into your association's own Stripe account. Stripe's processing fees are charged there.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing-faq-title">
    <div class="container-ubi">
      <SectionHeading id="pricing-faq-title" title="Pricing questions" class="mb-4" />
      <Faq groups={faqGroups} idPrefix="pricing-faq" />
    </div>
  </section>

  <CtaBand
    title="Get a quote for your association"
    text="Tell us roughly how many members you have and what you use today, and we'll send you a price."
    phone={{ src: portalHome, alt: "" }}
  />
</Base>
