{
  "name": "membercove-site",
  "private": true,
  "type": "module",
  "description": "The MemberCove marketing website: a static Astro site served by a Cloudflare Worker.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "pnpm run build && wrangler dev",
    "check": "pnpm run cf-typegen && astro check && tsc -p tsconfig.worker.json && vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface Env worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "lucide-static": "1.52.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
